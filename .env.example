# Copy to .env and fill in. Never commit .env.

# Pooled connection string (runtime). Neon: the "-pooler" host.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full"
# Direct (non-pooled) string used for migrations and seeding. Optional locally.
# DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full"

# Local development only: the API treats every request as this user.
# Used only when PIN access is not configured; never accepted on Vercel / production.
DEV_USER_ID=dev-user

# Private PIN access: run npm run pin:setup to generate these locally.
# Copy the generated values from .env into Vercel (server-only; no NEXT_PUBLIC_ prefix).
# Keep OWNER_USER_ID=dev-user to retain your existing data.
# OWNER_USER_ID="dev-user"
# APP_PIN_HASH="scrypt$..."
# SESSION_SECRET="...at least 32 random characters..."
