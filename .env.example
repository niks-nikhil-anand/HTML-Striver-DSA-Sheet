# Copy to .env and fill in. Never commit .env.

# Pooled connection string (runtime). Neon: the "-pooler" host.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full"
# Direct (non-pooled) string used for migrations and seeding. Optional locally.
# DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full"

# Local development only: the API treats every request as this user.
# Ignored (requests get 401) on Vercel / when NODE_ENV=production.
DEV_USER_ID=dev-user
